
import java.io.File;

import "http://www.example.org/uncertainty" as uncertainty
import "http://www.example.org/brakesystem" as brakesystem

reactions: uncertainty2brakesystem
in reaction to changes in uncertainty
execute actions in brakesystem

reaction UncertaintyAnnotationRepositoryInsertedAsRoot {
	after element uncertainty::UncertaintyAnnotationRepository inserted as root
  // newValue refers to the newly inserted element of type System (provided by the reactions runtime environment at runtime)
	call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(uncertainty::UncertaintyAnnotationRepository repo) {
	match {
    // we do only want to create a new corresponding Root if we not have one already and the old one has, e.g., only been moved
		require absence of brakesystem::Brakesystem corresponding to repo
	}
  create {
    // short way of using the respective Factory calls, which would be used in the update-block
    val mBrakesystem = new brakesystem::Brakesystem
  }
	update {
    // save the newly created Root element at the specified location
    persistProjectRelative(repo, mBrakesystem, new File("").toString() + "example.breakesystem")
    // register the correspondence so we can find mRoot later, if we modify something in system and need to adapt mRoot accordingly
		addCorrespondenceBetween(repo, mBrakesystem)
	}
}

