
import java.io.File;

import "http://www.example.org/uncertainty" as uncertainty


reactions: uncertainty2uncertainty
in reaction to changes in uncertainty
execute actions in uncertainty


reaction UncertaintyInserted {
    after element uncertainty::Uncertainty inserted in uncertainty::UncertaintyAnnotationRepository[uncertainties]
    call createCorrespondingUncertainty(affectedEObject, newValue)
}

routine createCorrespondingUncertainty(uncertainty::UncertaintyAnnotationRepository repo, uncertainty::Uncertainty uncertainty) {
    match {
        // not entirely sure if this what we want to do here
        require absence of uncertainty::Uncertainty corresponding to uncertainty
    }
    create {
        // short way of using the respective Factory calls, which would be used in the update-block
        val mUncertainty = new uncertainty::Uncertainty
    }
    update {
        // TODO: copy attributes from uncertainty to mUncertainty
        repo.uncertainties.add(mUncertainty)
        addCorrespondenceBetween(uncertainty, mUncertainty)
    }
}


reaction LocationInsertedIntoUncertainty {
    after element uncertainty::UncertaintyLocation replaced at uncertainty::Uncertainty[uncertaintyLocation]
    call createCorrespondingUncertaintyLocation(affectedEObject, newValue)
}
routine createCorrespondingUncertaintyLocation(uncertainty::Uncertainty uncertainty, uncertainty::UncertaintyLocation location) {
    match {
        // not entirely sure if this what we want to do here
        require absence of uncertainty::UncertaintyLocation corresponding to location
        val mUncertainty = retrieve uncertainty::Uncertainty corresponding to uncertainty
    }
    create {
        val mUncertaintyLocation = new uncertainty::UncertaintyLocation
    }
    update {
        mUncertainty.uncertaintyLocation = mUncertaintyLocation
        addCorrespondenceBetween(location, mUncertaintyLocation)
    }

}


reaction ReferenceInsertedIntoUncertaintyLocation {
    after element EObject inserted in uncertainty::UncertaintyLocation[referencesComponents]
    call createCorrespondingUncertaintyReference(affectedEObject, newValue)
}

routine createCorrespondingUncertaintyReference(uncertainty::UncertaintyLocation location, EObject reference) {
    match {
        // TODO: check if the reference is not already in the list
        val correspondingReference = retrieve EObject corresponding to reference
        val mUncertaintyLocation = retrieve uncertainty::UncertaintyLocation corresponding to location
        check !mUncertaintyLocation.referencesComponents.contains(correspondingReference)
    }
    update {
        mUncertaintyLocation.referencesComponents.add(correspondingReference)
    }
}

reaction UncertaintyRemoved {
    after element uncertainty::Uncertainty deleted
    call deleteUncertainty(affectedEObject)
}
routine deleteUncertainty(uncertainty::Uncertainty uncertainty) {
    match {
        val mUncertainty = retrieve uncertainty::Uncertainty corresponding to uncertainty
    }
    update {
        removeObject(mUncertainty)
        removeCorrespondenceBetween(uncertainty, mUncertainty)
    }
}
