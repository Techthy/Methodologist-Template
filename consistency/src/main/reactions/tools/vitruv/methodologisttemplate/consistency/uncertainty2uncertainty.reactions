
import java.io.File;

import "http://www.example.org/uncertainty" as uncertainty


reactions: uncertainty2uncertainty
in reaction to changes in uncertainty
execute actions in uncertainty


reaction UncertaintyInserted {
    after element uncertainty::Uncertainty inserted in uncertainty::UncertaintyAnnotationRepository[uncertainties]
    call createCorrespondingUncertainty(affectedEObject, newValue)
}

reaction ReferenceInsertedIntoUncertaintyLocation {
    after element EObject inserted in uncertainty::UncertaintyLocation[referencWesComponents]
    call createCorrespondingUncertaintyReference(affectedEObject, newValue)
}

